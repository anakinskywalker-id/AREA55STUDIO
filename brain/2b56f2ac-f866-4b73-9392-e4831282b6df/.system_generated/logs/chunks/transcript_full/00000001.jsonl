tama_Side\",\n    \"Kusen_Pintu_KM_Bawah\",\n    \"Kusen_Sliding_Deck_Dining\", \"Kaca_Sliding_Deck_Dining_1\", \"Kaca_Sliding_Deck_Dining_2\",\n    \"Kusen_Sliding_Living_Deck\", \"Kaca_Sliding_Living_Deck_1\", \"Kaca_Sliding_Living_Deck_2\",\n    \"Kusen_Pintu_KM_Atas\", \"Kusen_Pintu_Kamar\",\n    \"Kusen_Jendela_Belakang\", \"Kaca_Jendela_Belakang\",\n    \"Kusen_Boven_KM_Bawah\", \"Kaca_Boven_KM_Bawah\"\n]\n\nfor name in door_blockers:\n    obj = bpy.data.objects.get(name)\n    if obj:\n        bpy.data.objects.remove(obj, do_unlink=True)\n\ndef create_box(name, xmin, xmax, ymin, ymax, zmin, zmax, mat=None):\n    mesh = bpy.data.meshes.new(name)\n    obj = bpy.data.objects.new(name, mesh)\n    link_to_coll(obj)\n    \n    bm = bmesh.new()\n    dx = max(xmax - xmin, 0.001)\n    dy = max(ymax - ymin, 0.001)\n    dz = max(zmax - zmin, 0.001)\n    cx = (xmin + xmax) / 2.0\n    cy = (ymin + ymax) / 2.0\n    cz = (zmin + zmax) / 2.0\n    \n    bmesh.ops.create_cube(bm, size=1.0)\n    for v in bm.verts:\n        v.co.x = v.co.x * dx + cx\n        v.co.y = v.co.y * dy + cy\n        v.co.z = v.co.z * dz + cz\n        \n    bm.to_mesh(mesh)\n    bm.free()\n    \n    if mat:\n        obj.data.materials.append(mat)\n    return obj\n\n# Create realistic open door frames (jambs + header only)\n# 1. Main Entrance Door Frame\ntf = 0.05 # frame profile thickness\n# Left jamb\ncreate_box(\"Kusen_Pintu_Utama_Jamb_L\", 2.40, 2.45, 4.21, 4.34, 0.15, 2.15, mats[\"frame\"])\n# Right jamb\ncreate_box(\"Kusen_Pintu_Utama_Jamb_R\", 3.35, 3.40, 4.21, 4.34, 0.15, 2.15, mats[\"frame\"])\n# Top header\ncreate_box(\"Kusen_Pintu_Utama_Header\", 2.40, 3.40, 4.21, 4.34, 2.10, 2.15, mats[\"frame\"])\n# Swung open door leaf (swung at 60 deg inside)\ncreate_box(\"Daun_Pintu_Utama_Open\", 3.32, 3.37, 4.34, 5.15, 0.16, 2.10, mats[\"bedroom\"])\n\n# 2. KM Bawah Door Frame\ncreate_box(\"Kusen_KM_Bawah_Jamb_L\", 3.10, 3.15, 5.71, 5.84, 0.12, 2.10, mats[\"frame\"])\ncreate_box(\"Kusen_KM_Bawah_Jamb_R\", 3.85, 3.90, 5.71, 5.84, 0.12, 2.10, mats[\"frame\"])\ncreate_box(\"Kusen_KM_Bawah_Header\", 3.10, 3.90, 5.71, 5.84, 2.05, 2.10, mats[\"frame\"])\n\n# 3. Bedroom Door Frame\ncreate_box(\"Kusen_Kamar_Jamb_S\", 4.16, 4.29, 10.60, 10.65, 0.15, 2.10, mats[\"frame\"])\ncreate_box(\"Kusen_Kamar_Jamb_N\", 4.16, 4.29, 11.45, 11.50, 0.15, 2.10, mats[\"frame\"])\ncreate_box(\"Kusen_Kamar_Header\", 4.16, 4.29, 10.60, 11.50, 2.05, 2.10, mats[\"frame\"])\n\n# 4. KM Atas Door Frame\ncreate_box(\"Kusen_KM_Atas_Jamb_S\", 4.16, 4.29, 9.40, 9.45, 0.15, 2.10, mats[\"frame\"])\ncreate_box(\"Kusen_KM_Atas_Jamb_N\", 4.16, 4.29, 10.15, 10.20, 0.15, 2.10, mats[\"frame\"])\ncreate_box(\"Kusen_KM_Atas_Header\", 4.16, 4.29, 9.40, 10.20, 2.05, 2.10, mats[\"frame\"])\n\n# 5. Sliding Door to Deck Dining Frame (Header + slim jambs, open view!)\ncreate_box(\"Kusen_Slid_Dining_Jamb_S\", 2.81, 2.94, 6.20, 6.25, 0.15, 2.20, mats[\"frame\"])\ncreate_box(\"Kusen_Slid_Dining_Jamb_N\", 2.81, 2.94, 7.95, 8.00, 0.15, 2.20, mats[\"frame\"])\ncreate_box(\"Kusen_Slid_Dining_Header\", 2.81, 2.94, 6.20, 8.00, 2.15, 2.20, mats[\"frame\"])\n\n# 6. Sliding Door Living to Upper Deck Frame\ncreate_box(\"Kusen_Slid_Living_Jamb_W\", 1.60, 1.65, 11.81, 11.94, 0.15, 2.20, mats[\"frame\"])\ncreate_box(\"Kusen_Slid_Living_Jamb_E\", 3.75, 3.80, 11.81, 11.94, 0.15, 2.20, mats[\"frame\"])\ncreate_box(\"Kusen_Slid_Living_Header\", 1.60, 3.80, 11.81, 11.94, 2.15, 2.20, mats[\"frame\"])\n\n# --- 7. ARCHITECTURAL BUILT-IN FIXTURES (CABINETS & COUNTERS) ---\nmat_counter = bpy.data.materials[\"Mat_Dinding\"]\nmat_wood = bpy.data.materials[\"Mat_Lantai_Kamar\"]\nmat_white = bpy.data.materials[\"Mat_Lantai_KM2\"]\nmat_sofa = bpy.data.materials[\"Mat_Lantai_KM1\"]\n\n# Kitchen Counter along right wall (X: 5.75 to 6.35, Y: 6.0 to 8.2)\ncreate_box(\"Kitchen_Counter_Long\", 5.75, 6.35, 6.0, 8.2, 0.15, 1.00, mat_counter)\n# Kitchen Island / Dining Table (X: 3.6 to 5.2, Y: 6.6 to 7.4)\ncreate_box(\"Meja_Makan_Island\", 3.6, 5.0, 6.7, 7.3, 0.15, 0.90, mat_wood)\n\n# Master Bedroom Bed Platform (X: 4.8 to 6.2, Y: 11.2 to 12.6)\ncreate_box(\"Bed_Platform\", 4.8, 6.2, 11.2, 12.6, 0.15, 0.60, mat_sofa)\ncreate_box(\"Bed_Headboard\", 6.1, 6.3, 11.2, 12.6, 0.15, 1.10, mat_wood)\n\n# Living Room Sofa L-Shape\ncreate_box(\"Sofa_Living_Base\", 2.2, 3.8, 8.8, 9.7, 0.15, 0.55, mat_sofa)\ncreate_box(\"Sofa_Living_L_Extension\", 2.2, 2.8, 9.7, 10.8, 0.15, 0.55, mat_sofa)\n# Coffee Table\ncreate_box(\"Meja_Kopi\", 2.7, 3.5, 9.9, 10.5, 0.15, 0.45, mat_wood)\n# TV Console Bench along left wall\ncreate_box(\"TV_Bench_Console\", 1.25, 1.60, 8.6, 11.2, 0.15, 0.55, mat_wood)\n\n# Bathroom Vanity Sinks\ncreate_box(\"KM_Atas_Vanity\", 4.35, 4.95, 9.35, 9.85, 0.12, 0.95, mat_white)\ncreate_box(\"KM_Bawah_Washtafel\", 4.25, 4.75, 5.0, 5.6, 0.12, 0.95, mat_white)\n\nprint(\"Open frames, fixtures, and furniture accents added.\")\n","user_prompt":"buatkan bentuk 3d nya untuk dinding dan lantainya di blender"},"ServerName":"blender","ToolName":"execute_blender_code","toolAction":"Refining door frames and architectural accents","toolSummary":"Open frames and accents"}}]}
